{
  "name": "g2-model-viewer",
  "version": "0.1.0",
  "private": false,
  "description": "A Glyph-powered 3D model viewer for Even Realities G2, with automatic orbit, discrete R1/touch controls, GLB/OBJ loading and simulator support.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sim": "evenhub-simulator http://localhost:5173",
    "sim:automation": "evenhub-simulator http://localhost:5173 --automation-port 9898",
    "pack": "npm run build && evenhub pack app.json dist -o g2-model-viewer.ehpk",
    "typecheck": "tsc --noEmit",
    "test:renderer": "node tools/test-renderer.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.15",
    "@gabrielevierti/glyph": "0.3.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
